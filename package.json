{
  "name": "@immediately-run/grove",
  "version": "0.1.1",
  "type": "module",
  "main": "src/main.tsx",
  "immediately.run": {
    "$schema": "https://immediately.run/immediately-run-config.schema.json",
    "provides": [
      {
        "task": "open-wiki",
        "version": "1.0"
      }
    ],
    "invokes": [
      {
        "task": "edit-file",
        "version": "^1"
      }
    ],
    "requests": {
      "task:invoke": {}
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "verify": "npm run check:llms && npm run check:engine-api:selftest && npm run check:engine-api && npm run check:manifest && npm run check:deps && npm run lint && npm run build && npm run test",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:deps": "node scripts/check-app-dependencies.mjs --self-test && node scripts/check-app-dependencies.mjs",
    "check:engine-api": "node scripts/check-engine-api.mjs",
    "check:engine-api:selftest": "node scripts/check-engine-api.mjs --self-test",
    "gen:llms": "node scripts/gen-llms.mjs",
    "check:llms": "node scripts/gen-llms.mjs --check"
  },
  "dependencies": {
    "@immediately-run/mdx-plugins": "0.4.0",
    "@immediately-run/sdk": "^0.52.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@immediately-run/dev-fs": "^0.1.0",
    "@mdx-js/rollup": "^3.1.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.9",
    "@immediately-run/mdx-plugins": "0.4.0"
  },
  "description": "The Grove viewer: a kit of React components, layouts and themes for building immediately.run wikis. Composable as a fork, a dispatch target, or a pinned library.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/immediately-run/grove.git"
  },
  "exports": {
    ".": "./src/lib.ts",
    "./app": "./src/App.tsx",
    "./manifest": "./viewer.manifest.json",
    "./components": "./src/mdxComponents.ts",
    "./styles.css": "./src/GroveApp.css",
    "./theme.css": "./src/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "viewer.manifest.json",
    "viewer-manifest.schema.json",
    "README.md",
    "docs/ENGINE_BOUNDARY.md",
    "llms.txt"
  ],
  "peerDependencies": {
    "@immediately-run/sdk": "^0.52.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  }
}
